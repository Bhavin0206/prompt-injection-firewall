# Copy this file to .env and fill in your values:
#     copy backend\.env.example backend\.env
# .env is git-ignored — never commit real keys.

# ---- LLM (the smart detector) ----
# Pick ONE provider and paste its key. No code change needed to switch.
#
#   Gemini (free key):  https://aistudio.google.com/apikey
#   OpenAI:             https://platform.openai.com/api-keys
#
# NOTE: the app RUNS WITHOUT a key too — it then uses the rule detector only.

LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_MODEL=gpt-4o-mini
# DETECTOR_CONFIDENCE_THRESHOLD=0.60
# NEUTRALIZER_BLOCK_THRESHOLD=0.80
# MAX_CONTENT_LENGTH_CHARS=20000
